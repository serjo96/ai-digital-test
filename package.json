{
  "name": "shelf-ready",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14.1 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "pipeline": "npm run build && node dist/src/cli.js pipeline",
    "eval": "npm run build && node dist/src/cli.js eval",
    "benchmark": "npm run build && node dist/src/cli.js benchmark",
    "compare": "npm run build && node dist/src/cli.js compare",
    "web": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "web:prepare": "npm run build && node dist/src/prepare-web.js",
    "web:test": "node --experimental-strip-types --test web/test/*.test.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "dotenv": "17.4.2",
    "openai": "7.12.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
}
