# Local environment. Copy to `.env` or `.env.development` (gitignored).
# Precedence: `.env` < `.env.{NODE_ENV}` < exported shell variables < CLI flags.
# Never put keys in config/*.json, CLI arguments, Git, or the frontend.

FEED_PATH=supplier_feed.json
TAXONOMY_PATH=taxonomy.json
LABELS_PATH=eval/labels.json
REPORTS_DIR=reports/local

# Working development provider is Ollama. Switch to openai after the organizer key is set.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Required only for live OpenAI. Leave empty for B0/B1, replay, and local Ollama.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
