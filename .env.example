# Optional shell environment; the CLI does not auto-load .env files.
# Defaults point to the supplied inputs and provisional labels.
FEED_PATH=supplier_feed.json
TAXONOMY_PATH=taxonomy.json
LABELS_PATH=eval/labels.json
REPORTS_DIR=reports/local
# B0/B1 and offline tests need no API key.
# B2 live only after the user explicitly says the key has been added.
# The CLI does not load this file automatically. Keep the real key out of Git.
OPENAI_API_KEY=
